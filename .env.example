# Copy to .env (never commit .env). All settings are optional for local development.

# development | production  (production refuses to start with a weak JWT_SECRET)
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# SQLite by default; PostgreSQL in production (postgres:// and postgresql:// are both accepted)
# DATABASE_URL=postgresql://sentinel:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# ---- AI provider: offline (default, no key) | anthropic | openai ----
AI_PROVIDER=offline

# Anthropic (Claude Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallbacks for current Claude models (true/false)
ANTHROPIC_FALLBACKS=true

# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI, Groq, Ollama, LM Studio
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ollama example:   OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1
# LM Studio example: OPENAI_BASE_URL=http://localhost:1234/v1
AI_TIMEOUT_SECONDS=90

# ---- Pipeline ----
CORRELATION_WINDOW_MINUTES=60

# ---- Demo data & users (change these before any shared deployment) ----
SEED_DEMO_DATA=true
ADMIN_PASSWORD=Admin@12345
ANALYST_PASSWORD=Analyst@12345
VIEWER_PASSWORD=Viewer@12345

# Dev-only CORS for the Vite dev server (ignored in production)
CORS_ORIGINS=http://localhost:5173
